{
  "name": "azurlane-pet",
  "version": "0.2.0",
  "private": true,
  "description": "碧蓝航线 Live2D 桌面宠物，带 DSH token 用量与 DeepSeek 余额 HUD",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "snapshot": "electron . --snapshot",
    "fetch:skin": "node tools/fetch_skin.mjs",
    "fetch:all": "node tools/fetch_all.mjs",
    "verify": "node tools/verify_all.mjs",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.huannnn1.azurlanepet",
    "productName": "AzurLanePet",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "tools/dsh_usage.mjs",
      "tools/skin_names.json",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "tools/dsh_usage.mjs",
      "tools/skin_names.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AzurLanePet-${version}.exe"
    },
    "compression": "maximum"
  }
}
