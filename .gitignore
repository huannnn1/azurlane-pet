# 依赖
node_modules/

# Live2D 模型资源（体积大，用 tools/fetch_all.mjs 自己下）
assets/

# 个人配置（含 API Key）
config.json
# 解析失败时的备份、以及各类临时副本同样含 Key，别误提交
config.json.*

# 运行时产物
snapshot.png
tools/download.log
tools/failures.json
tools/.usage-cache.json

# 构建产物（build/ 例外：icon.png 要入库）
release/
dist/

# 系统
Thumbs.db
.DS_Store
*.log

# 测试/截图用的独立 profile
.snapshot-profile/
.calib-test-profile/
